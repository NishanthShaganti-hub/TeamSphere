# ==============================================================================
# Student Project & Team Finder (TeamSphere) - Environment Variables
# Copy this file to .env and configure values before starting the application.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development

# Secret Key for session signing and CSRF tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Connection URI (defaults to SQLite in instance/ directory)
DATABASE_URL=sqlite:///instance/teamsphere.db

# Optional College Email Domain Restriction (e.g., "college.edu" or leave blank for any domain)
ALLOWED_EMAIL_DOMAIN=

# Session Security (set to True when running behind HTTPS in production)
SESSION_COOKIE_SECURE=False

# Rate Limiter Storage URI (defaults to memory:// for development)
RATELIMIT_STORAGE_URI=memory://
