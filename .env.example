# ==============================================================================
# Student Project & Team Finder (TeamSphere) - Environment Variables
# Copy this file to .env and configure values before starting the application.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development

# Secret Key for session signing and CSRF tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key

# PostgreSQL connection URI (the local default is postgresql+psycopg:///teamsphere)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/teamsphere
# Dedicated PostgreSQL database for tests (include "test" in the database name)
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/teamsphere_test

# Optional College Email Domain Restriction (e.g., "college.edu" or leave blank for any domain)
ALLOWED_EMAIL_DOMAIN=

# Session Security (set to True when running behind HTTPS in production)
SESSION_COOKIE_SECURE=False

# Rate Limiter Storage URI (defaults to memory:// for development)
RATELIMIT_STORAGE_URI=memory://
